{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: clean",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "rm -rf bin/",
            "windows": {
                "command": "if (Test-Path bin) { Remove-Item -Recurse -Force bin }"
            },
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "label": "go: build",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "command": "go build -o ../bin/bedrock_helper ./cmd/bedrock_helper",
            "windows": {
                "command": "go build -o ../bin/bedrock_helper.exe ./cmd/bedrock_helper"
            },
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "label": "go: run",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./bin/bedrock_helper",
            "windows": {
                "command": ".\\bin\\bedrock_helper.exe"
            },
            "dependsOn": [
                "go: build"
            ],
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "label": "go: test",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/src"
            },
            "command": "go test -v ./...",
            "problemMatcher": [
                "$go"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}
